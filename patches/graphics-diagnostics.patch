diff --git a/sdk/src/graphics/vulkan/diagnostic_image_capture.h b/sdk/src/graphics/vulkan/diagnostic_image_capture.h
new file mode 100644
index 0000000..d29853e
--- /dev/null
+++ b/sdk/src/graphics/vulkan/diagnostic_image_capture.h
@@ -0,0 +1,159 @@
+#pragma once
+#include <cstdio>
+
+// Synchronous diagnostic readback. The caller has completed its submissions,
+// and the image is in SHADER_READ_ONLY_OPTIMAL on the graphics queue.
+static bool CaptureSwapSource(const rex::ui::vulkan::VulkanDevice* gpu, VkImage image,
+                              uint32_t width, uint32_t height, VkFormat format,
+                              uint32_t swizzle, const std::string& path, uint32_t depth = 1,
+                              VkSampleCountFlagBits samples = VK_SAMPLE_COUNT_1_BIT) {
+  // Supported diagnostic formats occupy four or eight bytes per texel.
+  const bool compressed = format >= VK_FORMAT_BC1_RGB_UNORM_BLOCK && format <= VK_FORMAT_BC5_SNORM_BLOCK;
+  if (!compressed && format != VK_FORMAT_R32G32_SFLOAT && format != VK_FORMAT_R32_SFLOAT &&
+      format != VK_FORMAT_R16G16B16A16_SFLOAT &&
+      format != VK_FORMAT_R16G16B16A16_UNORM &&
+      format != VK_FORMAT_R8G8B8A8_UNORM && format != VK_FORMAT_B8G8R8A8_UNORM &&
+      format != VK_FORMAT_A2B10G10R10_UNORM_PACK32 &&
+      format != VK_FORMAT_A2R10G10B10_UNORM_PACK32) return false;
+  const auto& fn = gpu->functions();
+  const auto device = gpu->device();
+  struct Resources {
+    const rex::ui::vulkan::VulkanDevice* gpu;
+    VkBuffer buffer = VK_NULL_HANDLE;
+    VkDeviceMemory memory = VK_NULL_HANDLE;
+    VkCommandPool pool = VK_NULL_HANDLE;
+    VkFence fence = VK_NULL_HANDLE;
+    VkImage resolved = VK_NULL_HANDLE;
+    VkDeviceMemory resolved_memory = VK_NULL_HANDLE;
+    ~Resources() {
+      const auto& fn = gpu->functions();
+      const auto device = gpu->device();
+      if (fence) fn.vkDestroyFence(device, fence, nullptr);
+      if (pool) fn.vkDestroyCommandPool(device, pool, nullptr);
+      if (buffer) fn.vkDestroyBuffer(device, buffer, nullptr);
+      if (memory) fn.vkFreeMemory(device, memory, nullptr);
+      if (resolved) fn.vkDestroyImage(device, resolved, nullptr);
+      if (resolved_memory) fn.vkFreeMemory(device, resolved_memory, nullptr);
+    }
+  } resources{gpu};
+  const VkDeviceSize size = compressed
+      ? VkDeviceSize((width + 3) / 4) * ((height + 3) / 4) * depth *
+            ((format <= VK_FORMAT_BC1_RGBA_SRGB_BLOCK ||
+              format == VK_FORMAT_BC4_UNORM_BLOCK || format == VK_FORMAT_BC4_SNORM_BLOCK) ? 8 : 16)
+      : VkDeviceSize(width) * height * depth *
+      ((format == VK_FORMAT_R32G32_SFLOAT || format == VK_FORMAT_R16G16B16A16_SFLOAT ||
+        format == VK_FORMAT_R16G16B16A16_UNORM) ? 8 : 4);
+  if (!rex::ui::vulkan::util::CreateDedicatedAllocationBuffer(
+          gpu, size, VK_BUFFER_USAGE_TRANSFER_DST_BIT,
+          rex::ui::vulkan::util::MemoryPurpose::kReadback,
+          resources.buffer, resources.memory)) return false;
+  if (samples != VK_SAMPLE_COUNT_1_BIT) {
+    if (depth != 1 || compressed) return false;
+    VkImageCreateInfo resolve{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    resolve.imageType = VK_IMAGE_TYPE_2D;
+    resolve.format = format;
+    resolve.extent = {width, height, 1};
+    resolve.mipLevels = resolve.arrayLayers = 1;
+    resolve.samples = VK_SAMPLE_COUNT_1_BIT;
+    resolve.tiling = VK_IMAGE_TILING_OPTIMAL;
+    resolve.usage = VK_IMAGE_USAGE_TRANSFER_DST_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT;
+    if (!rex::ui::vulkan::util::CreateDedicatedAllocationImage(
+        gpu, resolve, rex::ui::vulkan::util::MemoryPurpose::kDeviceLocal,
+        resources.resolved, resources.resolved_memory)) return false;
+  }
+  VkCommandPoolCreateInfo pool{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+  pool.queueFamilyIndex = gpu->queue_family_graphics_compute();
+  if (fn.vkCreateCommandPool(device, &pool, nullptr, &resources.pool) != VK_SUCCESS) return false;
+  VkCommandBufferAllocateInfo alloc{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+  alloc.commandPool = resources.pool;
+  alloc.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+  alloc.commandBufferCount = 1;
+  VkCommandBuffer command;
+  if (fn.vkAllocateCommandBuffers(device, &alloc, &command) != VK_SUCCESS) return false;
+  VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+  if (fn.vkBeginCommandBuffer(command, &begin) != VK_SUCCESS) return false;
+  VkImageMemoryBarrier barrier{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+  barrier.srcAccessMask = VK_ACCESS_SHADER_READ_BIT;
+  barrier.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+  barrier.oldLayout = VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL;
+  barrier.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+  barrier.srcQueueFamilyIndex = barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  barrier.image = image;
+  barrier.subresourceRange = rex::ui::vulkan::util::InitializeSubresourceRange();
+  fn.vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_ALL_COMMANDS_BIT,
+      VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &barrier);
+  if (resources.resolved) {
+    VkImageMemoryBarrier target{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    target.dstAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    target.oldLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    target.newLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    target.srcQueueFamilyIndex = target.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    target.image = resources.resolved;
+    target.subresourceRange = barrier.subresourceRange;
+    fn.vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &target);
+    VkImageResolve region{};
+    region.srcSubresource.aspectMask = region.dstSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+    region.srcSubresource.layerCount = region.dstSubresource.layerCount = 1;
+    region.extent = {width, height, 1};
+    fn.vkCmdResolveImage(command, image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+        resources.resolved, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1, &region);
+    target.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+    target.dstAccessMask = VK_ACCESS_TRANSFER_READ_BIT;
+    target.oldLayout = VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL;
+    target.newLayout = VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL;
+    fn.vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+        VK_PIPELINE_STAGE_TRANSFER_BIT, 0, 0, nullptr, 0, nullptr, 1, &target);
+  }
+  VkBufferImageCopy copy{};
+  copy.imageSubresource.aspectMask = VK_IMAGE_ASPECT_COLOR_BIT;
+  copy.imageSubresource.layerCount = 1;
+  copy.imageExtent = {width, height, depth};
+  fn.vkCmdCopyImageToBuffer(command, resources.resolved ? resources.resolved : image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL,
+                           resources.buffer, 1, &copy);
+  std::swap(barrier.oldLayout, barrier.newLayout);
+  std::swap(barrier.srcAccessMask, barrier.dstAccessMask);
+  VkBufferMemoryBarrier host{VK_STRUCTURE_TYPE_BUFFER_MEMORY_BARRIER};
+  host.srcAccessMask = VK_ACCESS_TRANSFER_WRITE_BIT;
+  host.dstAccessMask = VK_ACCESS_HOST_READ_BIT;
+  host.srcQueueFamilyIndex = host.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+  host.buffer = resources.buffer;
+  host.size = VK_WHOLE_SIZE;
+  fn.vkCmdPipelineBarrier(command, VK_PIPELINE_STAGE_TRANSFER_BIT,
+      VK_PIPELINE_STAGE_ALL_COMMANDS_BIT | VK_PIPELINE_STAGE_HOST_BIT,
+      0, 0, nullptr, 1, &host, 1, &barrier);
+  if (fn.vkEndCommandBuffer(command) != VK_SUCCESS) return false;
+  VkFenceCreateInfo fence{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+  if (fn.vkCreateFence(device, &fence, nullptr, &resources.fence) != VK_SUCCESS) return false;
+  VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+  submit.commandBufferCount = 1;
+  submit.pCommandBuffers = &command;
+  {
+    const auto queue = gpu->AcquireQueue(gpu->queue_family_graphics_compute(), 0);
+    if (fn.vkQueueSubmit(queue.queue(), 1, &submit, resources.fence) != VK_SUCCESS) return false;
+  }
+  if (fn.vkWaitForFences(device, 1, &resources.fence, VK_TRUE, UINT64_MAX) != VK_SUCCESS)
+    return false;
+  void* bytes = nullptr;
+  if (fn.vkMapMemory(device, resources.memory, 0, VK_WHOLE_SIZE, 0, &bytes) != VK_SUCCESS)
+    return false;
+  VkMappedMemoryRange range{VK_STRUCTURE_TYPE_MAPPED_MEMORY_RANGE};
+  range.memory = resources.memory;
+  range.size = VK_WHOLE_SIZE;
+  bool ok = fn.vkInvalidateMappedMemoryRanges(device, 1, &range) == VK_SUCCESS;
+  if (ok) {
+    FILE* file = std::fopen(path.c_str(), "wb");
+    ok = file && std::fwrite(bytes, 1, size_t(size), file) == size_t(size);
+    if (file) ok = std::fclose(file) == 0 && ok;
+  }
+  fn.vkUnmapMemory(device, resources.memory);
+  if (ok) {
+    FILE* info = std::fopen((path + ".txt").c_str(), "w");
+    if (info) {
+      std::fprintf(info, "width=%u\nheight=%u\ndepth=%u\nsamples=%u\nformat=%u\nswizzle=%u\n",
+                   width, height, depth, uint32_t(samples), uint32_t(format), swizzle);
+      std::fclose(info);
+    }
+  }
+  return ok;
+}
