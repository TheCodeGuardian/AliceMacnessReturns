 namespace rex {
 namespace ui {
 
+void CAMetalLayerSurface::SynchronizeDrawableSize(uint32_t width, uint32_t height, bool repair) {
+  CAMetalLayer* layer = (__bridge CAMetalLayer*)layer_;
+  CGSize actual = layer.drawableSize;
+  if (actual.width == width && actual.height == height) return;
+  REXLOG_WARN("[metal] drawable {}x{} disagrees with new swapchain {}x{}; repair {}",
+              actual.width, actual.height, width, height, repair);
+  if (repair) {
+    [CATransaction begin];
+    [CATransaction setDisableActions:YES];
+    layer.drawableSize = CGSizeMake(width, height);
+    [CATransaction commit];
+    [CATransaction flush];
+    REXLOG_INFO("[metal] drawable restored to {}x{}", layer.drawableSize.width, layer.drawableSize.height);
+  }
+}
