diff --git a/sdk/cmake/rexglue_helpers.cmake b/sdk/cmake/rexglue_helpers.cmake
index 19f2ed0..5e34a72 100644
--- a/sdk/cmake/rexglue_helpers.cmake
+++ b/sdk/cmake/rexglue_helpers.cmake
@@ -9,6 +9,12 @@
 include_guard(GLOBAL)
 
 function(_rexglue_stage_macos_vulkan_runtime target_name)
+    get_target_property(_is_bundle ${target_name} MACOSX_BUNDLE)
+    if(_is_bundle)
+        set(_vulkan_destination "$<TARGET_BUNDLE_CONTENT_DIR:${target_name}>/Resources/vulkan")
+    else()
+        set(_vulkan_destination "$<TARGET_FILE_DIR:${target_name}>/vulkan")
+    endif()
     if(TARGET Vulkan::Loader AND TARGET MoltenVK::MoltenVK)
         set(_rexglue_vulkan_loader Vulkan::Loader)
         set(_rexglue_moltenvk MoltenVK::MoltenVK)
@@ -23,17 +29,17 @@ function(_rexglue_stage_macos_vulkan_runtime target_name)
 
     add_custom_command(TARGET ${target_name} POST_BUILD
         COMMAND ${CMAKE_COMMAND} -E make_directory
-            "$<TARGET_FILE_DIR:${target_name}>/vulkan/lib"
-            "$<TARGET_FILE_DIR:${target_name}>/vulkan/share/vulkan/icd.d"
+            "${_vulkan_destination}/lib"
+            "${_vulkan_destination}/share/vulkan/icd.d"
         COMMAND ${CMAKE_COMMAND} -E copy_if_different
             "$<TARGET_FILE:${_rexglue_vulkan_loader}>"
-            "$<TARGET_FILE_DIR:${target_name}>/vulkan/lib/libvulkan.1.dylib"
+            "${_vulkan_destination}/lib/libvulkan.1.dylib"
         COMMAND ${CMAKE_COMMAND} -E copy_if_different
             "$<TARGET_FILE:${_rexglue_moltenvk}>"
-            "$<TARGET_FILE_DIR:${target_name}>/vulkan/lib/libMoltenVK.dylib"
+            "${_vulkan_destination}/lib/libMoltenVK.dylib"
         COMMAND ${CMAKE_COMMAND} -E copy_if_different
             "${_rexglue_moltenvk_icd}"
-            "$<TARGET_FILE_DIR:${target_name}>/vulkan/share/vulkan/icd.d/MoltenVK_icd.json"
+            "${_vulkan_destination}/share/vulkan/icd.d/MoltenVK_icd.json"
         VERBATIM
     )
 endfunction()
